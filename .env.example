# Core
DEBUG=true
SCHEDULER_TIMEZONE=Asia/Shanghai

# Enterprise WeChat smart bot (official WebSocket SDK)
# Create a smart bot in WeCom and copy its Bot ID / Secret here.
WECOM_BOT_ENABLED=false
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# Conversation/chat ID that receives ticket confirmation cards.
WECOM_BOT_CHAT_ID=
# Optional comma-separated WeCom user IDs allowed to confirm orders.
# Leave empty to allow any user who can click the card.
WECOM_ALLOWED_USER_IDS=
# Confirmation window; values are clamped to 15-300 seconds.
WECOM_CONFIRM_EXPIRE_SECONDS=60
